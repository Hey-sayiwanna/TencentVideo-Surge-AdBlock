#!name=腾讯视频测试6-个人中心广告Gzip
#!desc=解压 i.video.qq.com 的 gzip 请求体后精确识别个人中心广告 TRPC；其他请求原样放行
#!author=Hey-sayiwanna

[Script]
TencentVideo-PersonalCenter-Ad-v2 = type=http-request,pattern=^https:\/\/i\.video\.qq\.com\/?$,requires-body=1,binary-body-mode=1,max-size=65536,debug=1,engine=jsc,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/TencentVideo-Surge-AdBlock/main/TencentVideo-PersonalCenter-Ad-v2.js

[MITM]
hostname = %APPEND% i.video.qq.com
h2 = true
