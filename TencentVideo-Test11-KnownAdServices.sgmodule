#!name=腾讯视频测试11-已知广告TRPC精确拦截
#!desc=二进制扫描并拦截腾讯视频已知广告/推广 TRPC 服务；其他 i.video.qq.com 请求原样放行
#!author=Hey-sayiwanna

[Script]
TencentVideo-KnownAdServices-Block = type=http-request,pattern=^https:\/\/i\.video\.qq\.com\/?$,requires-body=1,binary-body-mode=1,max-size=65536,debug=1,engine=jsc,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/TencentVideo-Surge-AdBlock/main/TencentVideo-KnownAdServices-Block.js

[MITM]
hostname = %APPEND% i.video.qq.com
h2 = true
