#!name=腾讯视频去广告（持续更新）
#!desc=固定安装链接；当前版本 V22：针对 i.video.qq.com / live4iphoneRel 的 Protobuf 广告对象做等长原位失效，不改变响应长度，避免腾讯私有封装头失效。
#!author=Hey-sayiwanna

[Script]
TencentVideo-AdBlock-Latest = type=http-response,pattern=^https:\/\/i\.video\.qq\.com\/?$,requires-body=1,binary-body-mode=1,max-size=524288,debug=1,engine=jsc,timeout=10,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/TencentVideo-Surge-AdBlock/main/TencentVideo-V22-InPlace-AdDisable.js,script-update-interval=21600

[MITM]
hostname = %APPEND% i.video.qq.com
h2 = true
