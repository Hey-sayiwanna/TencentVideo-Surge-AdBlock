#!name=腾讯视频测试14-个人中心Banner去卡片请求补丁
#!desc=不再整包拦截 MVLPageService；仅把 personal_center_banner_day 原位替换为同长度无效槽位 personal_center_banner_off，尝试让个人中心广告卡片不再下发
#!author=Hey-sayiwanna

[Script]
TencentVideo-PersonalCenterBanner-Off = type=http-request,pattern=^https:\/\/i\.video\.qq\.com\/?$,requires-body=1,binary-body-mode=1,max-size=65536,debug=1,engine=jsc,script-path=https://raw.githubusercontent.com/Hey-sayiwanna/TencentVideo-Surge-AdBlock/main/TencentVideo-PersonalCenterBanner-Off.js

[MITM]
hostname = %APPEND% i.video.qq.com
h2 = true
